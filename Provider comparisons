            let totalSpread = 0;
            let comparableCount = 0;

            filteredRows.forEach(row => {
                const stats = analyzeRow(row);
                if (stats.validCount >= 2) {
                    comparableCount++;
                    totalSpread += stats.spreadPct;
                    stats.highestPayers.forEach(p => highestCounts[p]++);
                }
            });

            const avgSpread = comparableCount > 0 ? (totalSpread / comparableCount).toFixed(1) : '0.0';

            kpiContainer.innerHTML = `
                <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-2xs">

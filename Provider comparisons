        // Analyze row pricing stats (Max, Min, Spread %, Highest Payers)
        function analyzeRow(row) {
            const payers = ['rasool', 'reaya', 'daman', 'coop'];
            const prices = {};
            const validValues = [];

            payers.forEach(p => {
                const val = getEffectivePrice(row, p);
                prices[p] = val;
                if (val !== null && val > 0) {
                    validValues.push(val);
                }
            });

            if (validValues.length === 0) {
                return { prices, maxVal: null, minVal: null, spreadPct: 0, highestPayers: [], validCount: 0 };
            }

            const maxVal = Math.max(...validValues);
            const minVal = Math.min(...validValues);
            const highestPayers = payers.filter(p => prices[p] === maxVal && maxVal > 0);
            const spreadPct = (validValues.length >= 2 && minVal > 0)
                ? ((maxVal - minVal) / minVal) * 100
                : 0;

            return {
                prices,
                maxVal,
                minVal,
                spreadPct,
                highestPayers,
                validCount: validValues.length
            };
        }

        // Render KPI Summary Cards
        function renderKPIs(filteredRows) {

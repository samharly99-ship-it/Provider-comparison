            if (row.kType && state.endoscopyMode === 'k_calc') {
                const units = row.kType === 'gastro' ? state.gastroK : state.colonoK;
                if (!units || units <= 0) return null;
                if (payerKey === 'rasool') return units * K_RATES.rasool;
                if (payerKey === 'reaya') return units * K_RATES.reaya;
                if (payerKey === 'daman') return units * K_RATES.daman;
                if (payerKey === 'coop') {
                    const rate = row.setting === 'Inpatient' ? K_RATES.coop_inpatient : K_RATES.coop_outpatient;
                    return units * rate;
                }
            }
            return row[payerKey]?.price ?? null;
        }


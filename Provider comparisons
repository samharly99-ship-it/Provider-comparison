index.html
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>مقارنة التعرفات الطبية | Lebanese Medical Tariff Comparator</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Cairo', 'Inter', sans-serif;
            background-color: #f8fafc;
            color: #0f172a;
        }
        .font-en {
            font-family: 'Inter', sans-serif;
        }
        /* Custom subtle scrollbar for wide tables */
        .table-container::-webkit-scrollbar {
            height: 8px;
        }
        .table-container::-webkit-scrollbar-track {
            background: #f1f5f9;
            border-radius: 8px;
        }
        .table-container::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 8px;
        }
        .table-container::-webkit-scrollbar-thumb:hover {
            background: #94a3b8;
        }
        .highest-cell {
            background: linear-gradient(135deg, #fffbeb 0%, #fef3c7 100%);
            border: 1.5px solid #f59e0b !important;
            box-shadow: inset 0 0 0 1px rgba(245, 158, 11, 0.2);
        }
    </style>
</head>
<body class="min-h-screen flex flex-col">

    <!-- Top Navigation Header -->
    <header class="bg-slate-900 text-white shadow-lg sticky top-0 z-30">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4 flex flex-col md:flex-row md:items-center md:justify-between gap-3">
            <div>
                <div class="flex items-center gap-2.5">
                    <span class="bg-emerald-500 text-slate-950 font-bold px-2.5 py-0.5 rounded-md text-xs font-en">TARIFF ENGINE</span>
                    <h1 class="text-lg sm:text-xl font-bold tracking-tight">نظام مقارنة التعرفات الطبية والجهات الضامنة</h1>
                </div>
                <p class="text-slate-400 text-xs sm:text-sm mt-0.5 font-en">
                    Rasool (مستشفى الرسول الأعظم) vs. الرعاية الصحية vs. الضمان الاجتماعي vs. تعاونية موظفي الدولة
                </p>
            </div>
            <div class="flex flex-wrap items-center gap-2">
                <button onclick="openAddModal()" class="bg-emerald-600 hover:bg-emerald-500 text-white text-xs sm:text-sm font-semibold px-3.5 py-2 rounded-lg transition flex items-center gap-1.5 shadow-sm">
                    <span>+</span>
                    <span>إضافة خدمة / Add Row</span>
                </button>
                <button onclick="exportCSV()" class="bg-slate-800 hover:bg-slate-700 border border-slate-700 text-slate-200 text-xs sm:text-sm font-semibold px-3.5 py-2 rounded-lg transition flex items-center gap-1.5">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
                    <span>تصدير CSV</span>
                </button>
            </div>
        </div>
    </header>

    <!-- Main Container -->
    <main class="max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6 flex-1 space-y-6">

        <!-- KPI Summary Strip -->
        <section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4" id="kpi-container">
            <!-- Dynamically populated -->
        </section>

        <!-- Interactive K-Multiplier Control Panel (Gastroscopy & Colonoscopy) -->
        <section class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
            <div class="bg-gradient-to-l from-indigo-950 via-slate-900 to-slate-900 text-white px-5 py-4 flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4">
                <div>
                    <div class="flex items-center gap-2">
                        <span class="bg-amber-400 text-slate-950 text-xs font-extrabold px-2 py-0.5 rounded font-en">K × UNITS</span>
                        <h2 class="text-base sm:text-lg font-bold">حاسبة معامل الـ K للتنظير (Gastroscopy & Colonoscopy)</h2>
                    </div>
                    <p class="text-slate-300 text-xs mt-1">
                        أدخل عدد وحدات <span class="font-en font-semibold text-amber-300">K</span> (مثلاً <span class="font-en font-bold">30</span>) ليتم ضربها بقيمة <span class="font-en font-bold">K</span> الخاصة بكل جهة ضامنة ومقارنتها مع السقف الثابت.
                    </p>
                </div>

                <!-- Mode Switcher -->
                <div class="flex items-center bg-slate-800/90 p-1 rounded-xl border border-slate-700 self-start lg:self-auto">
                    <button id="mode-k-btn" onclick="setEndoscopyMode('k_calc')" class="px-3 py-1.5 rounded-lg text-xs font-bold transition bg-amber-400 text-slate-950 shadow">
                        احتساب حسب (K × العدد)
                    </button>
                    <button id="mode-fixed-btn" onclick="setEndoscopyMode('fixed')" class="px-3 py-1.5 rounded-lg text-xs font-bold transition text-slate-300 hover:text-white">
                        السقف المقطوع الثابت
                    </button>
                </div>
            </div>

            <div class="p-5 grid grid-cols-1 lg:grid-cols-12 gap-5 items-center bg-slate-50/70">
                <!-- Payer K Rates Reference -->
                <div class="lg:col-span-5 grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-2 gap-2.5">
                    <div class="bg-white p-3 rounded-xl border border-slate-200 shadow-2xs">
                        <div class="text-[11px] text-slate-500 font-semibold">مستشفى الرسول (Rasool)</div>
                        <div class="text-base font-extrabold text-slate-900 font-en mt-0.5">1 K = $4.00</div>
                    </div>
                    <div class="bg-amber-50/60 p-3 rounded-xl border border-amber-200">
                        <div class="text-[11px] text-amber-800 font-semibold">الرعاية الصحية</div>
                        <div class="text-base font-extrabold text-amber-950 font-en mt-0.5">1 K = $4.00</div>
                    </div>
                    <div class="bg-sky-50/60 p-3 rounded-xl border border-sky-200">
                        <div class="text-[11px] text-sky-800 font-semibold">الضمان الاجتماعي</div>
                        <div class="text-base font-extrabold text-sky-950 font-en mt-0.5">1 K = $4.00</div>
                    </div>
                    <div class="bg-emerald-50/60 p-3 rounded-xl border border-emerald-200">
                        <div class="text-[11px] text-emerald-800 font-semibold">تعاونية موظفي الدولة</div>
                        <div class="text-xs sm:text-sm font-extrabold text-emerald-950 font-en mt-0.5">
                            $5 <span class="font-normal text-[11px] font-sans">(داخل)</span> / $2 <span class="font-normal text-[11px] font-sans">(خارج)</span>
                        </div>
                    </div>
                </div>

                <!-- Interactive K Inputs for Gastroscopy & Colonoscopy -->
                <div class="lg:col-span-7 grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <!-- Gastroscopy K input -->
                    <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-2xs">
                        <div class="flex items-center justify-between mb-2">
                            <label for="gastro-k-input" class="text-xs font-bold text-slate-800">
                                تنظير المعدة <span class="font-en text-indigo-600">(Gastroscopy K)</span>
                            </label>
                            <span class="text-[11px] bg-indigo-50 text-indigo-700 font-semibold px-2 py-0.5 rounded font-en" id="gastro-preview-tag">30 × K</span>
                        </div>
                        <div class="flex items-center gap-2">
                            <input type="number" id="gastro-k-input" value="30" min="1" max="500" step="1"
                                oninput="updateKValues()"
                                class="w-full font-en text-lg font-extrabold text-slate-900 bg-slate-50 border border-slate-300 rounded-lg px-3 py-1.5 focus:outline-none focus:ring-2 focus:ring-indigo-500">
                            <span class="text-xs font-bold text-slate-500 font-en">K</span>
                        </div>
                        <div class="mt-2.5 text-[11px] text-slate-600 flex flex-wrap gap-x-3 gap-y-1 font-en" id="gastro-live-breakdown">
                            <!-- Filled dynamically -->
                        </div>
                    </div>

                    <!-- Colonoscopy K input -->
                    <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-2xs">
                        <div class="flex items-center justify-between mb-2">
                            <label for="colono-k-input" class="text-xs font-bold text-slate-800">
                                تنظير القولون <span class="font-en text-indigo-600">(Colonoscopy K)</span>
                            </label>
                            <span class="text-[11px] bg-indigo-50 text-indigo-700 font-semibold px-2 py-0.5 rounded font-en" id="colono-preview-tag">30 × K</span>
                        </div>
                        <div class="flex items-center gap-2">
                            <input type="number" id="colono-k-input" value="30" min="1" max="500" step="1"
                                oninput="updateKValues()"
                                class="w-full font-en text-lg font-extrabold text-slate-900 bg-slate-50 border border-slate-300 rounded-lg px-3 py-1.5 focus:outline-none focus:ring-2 focus:ring-indigo-500">
                            <span class="text-xs font-bold text-slate-500 font-en">K</span>
                        </div>
                        <div class="mt-2.5 text-[11px] text-slate-600 flex flex-wrap gap-x-3 gap-y-1 font-en" id="colono-live-breakdown">
                            <!-- Filled dynamically -->
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Filters & Comparison Baseline Controls -->
        <section class="bg-white p-4 rounded-2xl border border-slate-200 shadow-sm space-y-4">
            <!-- Prominent Multi-Select Service Picker -->
            <div class="bg-slate-50 p-3.5 rounded-xl border border-slate-200 space-y-2.5">
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
                    <div class="flex items-center gap-2">
                        <span class="bg-slate-900 text-white text-[11px] font-bold px-2 py-0.5 rounded font-en">SERVICES</span>
                        <label class="text-xs sm:text-sm font-bold text-slate-800">اختيار الخدمات للمقارنة <span class="font-en text-slate-500 font-semibold">(Select Services)</span></label>
                    </div>
                    <div class="flex flex-wrap items-center gap-1.5 text-xs">
                        <button type="button" onclick="selectAllServices()" class="px-2.5 py-1 rounded-lg bg-slate-900 text-white font-semibold hover:bg-slate-800 transition">
                            الكل (All)
                        </button>
                        <button type="button" onclick="selectComparableOnly()" class="px-2.5 py-1 rounded-lg bg-emerald-50 text-emerald-800 border border-emerald-200 font-semibold hover:bg-emerald-100 transition">
                            المشتركة فقط (2+ Payers)
                        </button>
                        <button type="button" onclick="clearSelectedServices()" class="px-2.5 py-1 rounded-lg bg-white text-rose-700 border border-rose-200 font-semibold hover:bg-rose-50 transition">
                            مسح التحديد (Clear)
                        </button>
                    </div>
                </div>

                <!-- Dropdown Trigger + Searchable Checklist Popover -->
                <div class="relative" id="service-picker-wrapper">
                    <button type="button" onclick="toggleServiceDropdown()"
                        class="w-full bg-white border border-slate-300 hover:border-slate-400 rounded-xl px-3.5 py-2.5 text-sm flex items-center justify-between shadow-2xs transition focus:outline-none focus:ring-2 focus:ring-slate-900">
                        <div class="flex items-center gap-2 truncate">
                            <svg class="w-4 h-4 text-slate-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/></svg>
                            <span id="service-picker-summary" class="font-bold text-slate-800 truncate">جميع الخدمات محددة (All Services)</span>
                        </div>
                        <span class="text-xs font-en font-bold bg-slate-100 text-slate-700 px-2 py-0.5 rounded-md shrink-0" id="service-picker-count">0 / 0</span>
                    </button>

                    <!-- Popover Menu -->
                    <div id="service-picker-popover" class="hidden absolute right-0 left-0 mt-1.5 bg-white rounded-2xl border border-slate-300 shadow-2xl z-40 overflow-hidden">
                        <div class="p-3 bg-slate-50 border-b border-slate-200 flex flex-col sm:flex-row gap-2">
                            <input type="text" id="picker-search-input" oninput="renderServiceChecklist()"
                                placeholder="ابحث داخل القائمة لاختيار خدمات محددة (مثال: MRI, Echo, سرير, EP, Stent)..."
                                class="w-full bg-white border border-slate-300 rounded-lg px-3 py-1.5 text-xs focus:outline-none focus:ring-2 focus:ring-slate-900">
                            <button type="button" onclick="toggleServiceDropdown()" class="px-3 py-1.5 bg-slate-900 text-white rounded-lg text-xs font-bold shrink-0">
                                تم (Done)
                            </button>
                        </div>
                        <div id="service-checklist-container" class="max-h-80 overflow-y-auto p-2 space-y-2 divide-y divide-slate-100">
                            <!-- Grouped checkboxes rendered dynamically -->
                        </div>
                    </div>
                </div>

                <!-- Selected Service Removable Chips (shown when a custom subset is active) -->
                <div id="selected-chips-container" class="hidden flex-wrap gap-1.5 pt-1 max-h-24 overflow-y-auto"></div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-3 items-end">
                <!-- Search -->
                <div class="lg:col-span-4">
                    <label class="block text-xs font-bold text-slate-700 mb-1">بحث سريع في الجدول (عربي / English)</label>
                    <div class="relative">
                        <input type="text" id="search-input" oninput="renderTable()" placeholder="مثال: MRI, سرير, Gastroscopy, Echo..."
                            class="w-full bg-slate-50 border border-slate-300 rounded-xl px-3.5 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-slate-900">
                    </div>
                </div>

                <!-- Category Filter -->
                <div class="lg:col-span-3">
                    <label class="block text-xs font-bold text-slate-700 mb-1">تصنيف الخدمة (Category)</label>
                    <select id="category-filter" onchange="renderTable()"
                        class="w-full bg-slate-50 border border-slate-300 rounded-xl px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-slate-900">
                        <option value="ALL">جميع التصنيفات (All Categories)</option>
                    </select>
                </div>

                <!-- Setting Filter -->
                <div class="lg:col-span-2">
                    <label class="block text-xs font-bold text-slate-700 mb-1">نوع الاستشفاء</label>
                    <select id="setting-filter" onchange="renderTable()"
                        class="w-full bg-slate-50 border border-slate-300 rounded-xl px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-slate-900">
                        <option value="ALL">الكل (All)</option>
                        <option value="Inpatient">داخل المستشفى (Inpatient)</option>
                        <option value="Outpatient">خارجي (Outpatient)</option>
                        <option value="General">عام / وحدات (General)</option>
                    </select>
                </div>

                <!-- % Difference Baseline Selector -->
                <div class="lg:col-span-3">
                    <label class="block text-xs font-bold text-slate-700 mb-1">مرجع احتساب فرق النسبة (% Diff)</label>
                    <select id="diff-baseline" onchange="renderTable()"
                        class="w-full bg-amber-50/70 border border-amber-300 text-amber-950 font-semibold rounded-xl px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-amber-500">
                        <option value="vs_lowest">مقارنة بالأدنى (vs. Lowest Price)</option>
                        <option value="vs_highest">الفرق عن الأعلى (vs. Highest Price)</option>
                        <option value="vs_rasool">مقارنة بالرسول (vs. Rasool Baseline)</option>
                    </select>
                </div>
            </div>

            <!-- Quick Toggles & Legend -->
            <div class="flex flex-wrap items-center justify-between gap-3 pt-2 border-t border-slate-100 text-xs">
                <div class="flex flex-wrap items-center gap-4">
                    <label class="inline-flex items-center gap-2 cursor-pointer select-none font-semibold text-slate-700">
                        <input type="checkbox" id="matched-only-toggle" onchange="renderTable()" class="rounded border-slate-300 text-slate-900 focus:ring-slate-900 w-4 h-4">
                        <span>إظهار الخدمات المشتركة بين جهتين أو أكثر فقط (Matched Only)</span>
                    </label>
                    <label class="inline-flex items-center gap-2 cursor-pointer select-none font-semibold text-slate-700">
                        <input type="checkbox" id="highest-diff-sort" onchange="renderTable()" class="rounded border-slate-300 text-slate-900 focus:ring-slate-900 w-4 h-4">
                        <span>ترتيب حسب أعلى فرق نسبة مئوية (Sort by Highest % Spread)</span>
                    </label>
                </div>
                <div class="flex items-center gap-3">
                    <span class="inline-flex items-center gap-1.5 font-semibold text-amber-800 bg-amber-100 border border-amber-300 px-2.5 py-1 rounded-lg">
                        <span class="w-2.5 h-2.5 rounded-full bg-amber-500"></span>
                        <span>الأعلى سعراً / سقفاً (Highest)</span>
                    </span>
                </div>
            </div>
        </section>

        <!-- Main Comparison Data Table -->
        <section class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
            <div class="table-container overflow-x-auto">
                <table class="w-full text-right border-collapse min-w-[980px]">
                    <thead>
                        <tr class="bg-slate-900 text-white text-xs uppercase tracking-wider">
                            <th class="py-3.5 px-4 font-bold w-1/4">الخدمة الطبية / Service</th>
                            <th class="py-3.5 px-3 font-bold text-center bg-slate-800 border-x border-slate-700">
                                <div>مستشفى الرسول</div>
                                <div class="text-[10px] text-slate-300 font-en font-normal">Rasool Tariff ($)</div>
                            </th>
                            <th class="py-3.5 px-3 font-bold text-center bg-amber-950/90 border-x border-slate-700">
                                <div>الرعاية الصحية</div>
                                <div class="text-[10px] text-amber-200 font-en font-normal">MOH / الرعاية</div>
                            </th>
                            <th class="py-3.5 px-3 font-bold text-center bg-sky-950/90 border-x border-slate-700">
                                <div>الضمان الاجتماعي</div>
                                <div class="text-[10px] text-sky-200 font-en font-normal">NSSF / الضمان</div>
                            </th>
                            <th class="py-3.5 px-3 font-bold text-center bg-emerald-950/90 border-x border-slate-700">
                                <div>تعاونية موظفي الدولة</div>
                                <div class="text-[10px] text-emerald-200 font-en font-normal">Coop / التعاونية</div>
                            </th>
                            <th class="py-3.5 px-3 font-bold text-center bg-slate-800">
                                <div>الأعلى وفارق النسبة</div>
                                <div class="text-[10px] text-amber-300 font-en font-normal">Highest & % Spread</div>
                            </th>
                        </tr>
                    </thead>
                    <tbody id="comparison-tbody" class="divide-y divide-slate-200 text-sm">
                        <!-- Rendered via JS -->
                    </tbody>
                </table>
            </div>
            <div id="empty-state" class="hidden py-12 text-center text-slate-500">
                <p class="font-bold text-base">لا توجد خدمات مطابقة لخيارات البحث الحالية</p>
                <p class="text-xs mt-1">حاول تغيير كلمات البحث أو إزالة الفلاتر.</p>
            </div>
        </section>

    </main>

    <!-- Add Custom Service Modal -->
    <div id="add-modal" class="fixed inset-0 bg-slate-950/60 backdrop-blur-xs z-50 hidden items-center justify-center p-4">
        <div class="bg-white rounded-2xl max-w-lg w-full shadow-2xl border border-slate-200 overflow-hidden">
            <div class="bg-slate-900 text-white px-5 py-3.5 flex items-center justify-between">
                <h3 class="font-bold text-base">إضافة خدمة طبية للمقارنة</h3>
                <button onclick="closeAddModal()" class="text-slate-400 hover:text-white text-xl leading-none">&times;</button>
            </div>
            <form onsubmit="handleAddService(event)" class="p-5 space-y-3.5 text-sm">
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-1">اسم الخدمة (عربي)</label>
                        <input type="text" id="new-ar" required placeholder="مثال: صورة صوتية للبطن" class="w-full border border-slate-300 rounded-lg px-3 py-2">
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-1">Service Name (English)</label>
                        <input type="text" id="new-en" required placeholder="e.g. Abdominal Ultrasound" class="w-full border border-slate-300 rounded-lg px-3 py-2 font-en">
                    </div>
                </div>
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-1">التصنيف</label>
                        <select id="new-cat" class="w-full border border-slate-300 rounded-lg px-3 py-2">
                            <option value="Consultations & Respiratory">Consultations & Respiratory</option>
                            <option value="Hospital Beds & Multipliers">Hospital Beds & Multipliers</option>
                            <option value="Imaging & Scans">Imaging & Scans</option>
                            <option value="Endoscopy & Procedures">Endoscopy & Procedures</option>
                            <option value="Cardiology & EP">Cardiology & EP</option>
                            <option value="Ophthalmology & Specialty">Ophthalmology & Specialty</option>
                            <option value="Implants & Medical Supplies">Implants & Medical Supplies</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-1">النوع (Setting)</label>
                        <select id="new-setting" class="w-full border border-slate-300 rounded-lg px-3 py-2">
                            <option value="Outpatient">Outpatient (خارجي)</option>
                            <option value="Inpatient">Inpatient (داخل المستشفى)</option>
                            <option value="General">General (عام)</option>
                        </select>
                    </div>
                </div>
                <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5 pt-2">
                    <div>
                        <label class="block text-[11px] font-bold text-slate-700 mb-1">Rasool ($)</label>
                        <input type="number" step="0.01" id="new-rasool" placeholder="0" class="w-full border border-slate-300 rounded-lg px-2.5 py-1.5 font-en">
                    </div>
                    <div>
                        <label class="block text-[11px] font-bold text-amber-800 mb-1">الرعاية ($)</label>

                            <div class="font-bold text-slate-900 text-sm">${row.ar}</div>
                            <div class="text-xs text-slate-500 font-en">${row.en}</div>
                        </td>

                        ${renderPayerCell(row, 'rasool', stats, baselineMode)}
                        ${renderPayerCell(row, 'reaya', stats, baselineMode)}
                        ${renderPayerCell(row, 'daman', stats, baselineMode)}
                        ${renderPayerCell(row, 'coop', stats, baselineMode)}

                        <td class="py-3 px-3 text-center align-middle bg-slate-50/60">
                            ${stats.validCount >= 2 ? `
                                <div class="inline-flex flex-col items-center">
                                    <span class="text-xs font-extrabold text-amber-800 bg-amber-100 border border-amber-300 px-2.5 py-0.5 rounded-full">
                                        ${highestNames}
                                    </span>
                                    <span class="text-sm font-extrabold font-en text-rose-600 mt-1">
                                        +${stats.spreadPct.toFixed(1)}%
                                    </span>
                                    <span class="text-[10px] text-slate-400 font-en">
                                        (${formatUSD(stats.minVal)} → ${formatUSD(stats.maxVal)})
                                    </span>
                                </div>
                            ` : `
                                <span class="text-xs text-slate-400">جهة واحدة فقط</span>
                            `}
                        </td>
                    </tr>
                `;
            }).join('');
        }

        // Modal Controls
        function openAddModal() {
            const modal = document.getElementById('add-modal');
            modal.classList.remove('hidden');
            modal.classList.add('flex');
        }

        function closeAddModal() {
            const modal = document.getElementById('add-modal');
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }

        function handleAddService(e) {
            e.preventDefault();
            const ar = document.getElementById('new-ar').value.trim();
            const en = document.getElementById('new-en').value.trim();
            const cat = document.getElementById('new-cat').value;
            const setting = document.getElementById('new-setting').value;

            const parseOpt = (id) => {
                const v = document.getElementById(id).value;
                return v !== '' ? parseFloat(v) : null;
            };

            const catMap = {
                'Consultations & Respiratory': 'المعاينات والجلسات والتنفس',
                'Hospital Beds & Multipliers': 'الأسرة والغرف والمعاملات',
                'Imaging & Scans': 'التصوير الطبي والأشعة',
                'Endoscopy & Procedures': 'التنظير والإجراءات الطبية',
                'Cardiology & EP': 'القلب وتخطيط كهرباء القلب',
                'Ophthalmology & Specialty': 'طب العيون وعلاجات تخصصية',
                'Implants & Medical Supplies': 'المستلزمات الطبية والزرعات'
            };

            const newId = 'custom-' + Date.now();
            servicesData.unshift({
                id: newId,
                category: cat,
                categoryAr: catMap[cat] || cat,
                setting,
                ar,
                en,
                rasool: { price: parseOpt('new-rasool') },
                reaya: { price: parseOpt('new-reaya') },
                daman: { price: parseOpt('new-daman') },
                coop: { price: parseOpt('new-coop') }
            });

            state.selectedIds.add(newId);
            e.target.reset();
            closeAddModal();
            initCategories();
            syncServicePickerUI();
            renderTable();
            showToast('تمت إضافة الخدمة وتحديث المقارنة بنجاح');
        }

        // Export current comparison to CSV
        function exportCSV() {
            const headers = ['Category', 'Service_AR', 'Service_EN', 'Setting', 'Rasool_USD', 'Reaya_USD', 'Daman_USD', 'Coop_USD', 'Highest_Payer', 'Spread_Pct'];
            const payerLabels = { rasool: 'Rasool', reaya: 'Reaya', daman: 'Daman', coop: 'Coop' };

            const rows = servicesData.map(row => {
                const stats = analyzeRow(row);
                const highest = stats.highestPayers.map(p => payerLabels[p]).join(' & ') || 'N/A';
                return [
                    `"${row.category}"`,
                    `"${row.ar}"`,
                    `"${row.en}"`,
                    row.setting,
                    stats.prices.rasool ?? '',
                    stats.prices.reaya ?? '',
                    stats.prices.daman ?? '',
                    stats.prices.coop ?? '',
                    `"${highest}"`,
                    stats.spreadPct.toFixed(1) + '%'
                ].join(',');
            });

            const csvContent = '\uFEFF' + [headers.join(','), ...rows].join('\n');
            const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = `lebanese_tariff_comparison_${new Date().toISOString().slice(0,10)}.csv`;
            a.click();
            URL.revokeObjectURL(url);
            showToast('تم تحميل ملف المقارنة بصيغة CSV');
        }

        function showToast(msg) {
            const toast = document.getElementById('toast');
            toast.textContent = msg;
            toast.classList.remove('opacity-0');
            setTimeout(() => toast.classList.add('opacity-0'), 3000);
        }

        // Initialize application
        window.onload = function () {
            state.selectedIds = new Set(servicesData.map(s => s.id));
            initCategories();
            syncServicePickerUI();
            updateKValues();
        };
    </script>

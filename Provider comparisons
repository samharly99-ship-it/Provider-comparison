                        </div>
                    </div>
                </div>
            `;
        }

        // Format percentage badge relative to chosen baseline
        function getDiffBadgeHTML(val, stats, baselineMode, rasoolVal) {
            if (val === null || val <= 0 || stats.validCount < 2) return '';

            if (baselineMode === 'vs_lowest') {
                if (val === stats.minVal) {
                    return `<span class="inline-block text-[10px] font-en font-bold text-emerald-700 bg-emerald-50 px-1.5 py-0.5 rounded">Lowest</span>`;
                }
                const pct = ((val - stats.minVal) / stats.minVal) * 100;
                return `<span class="inline-block text-[10px] font-en font-bold text-rose-700 bg-rose-50 px-1.5 py-0.5 rounded">+${pct.toFixed(1)}% vs min</span>`;
            }

            if (baselineMode === 'vs_highest') {
                if (val === stats.maxVal) {
                    return `<span class="inline-block text-[10px] font-en font-bold text-amber-900 bg-amber-200/80 px-1.5 py-0.5 rounded">Highest (100%)</span>`;
                }
                const pct = ((val - stats.maxVal) / stats.maxVal) * 100;
                return `<span class="inline-block text-[10px] font-en font-semibold text-slate-600 bg-slate-100 px-1.5 py-0.5 rounded">${pct.toFixed(1)}%</span>`;
            }

            if (baselineMode === 'vs_rasool') {
                if (rasoolVal === null || rasoolVal <= 0) return '';
                if (val === rasoolVal) {
                    return `<span class="inline-block text-[10px] font-en font-semibold text-slate-500 bg-slate-100 px-1.5 py-0.5 rounded">0% (Base)</span>`;
                }
                const pct = ((val - rasoolVal) / rasoolVal) * 100;
                const sign = pct > 0 ? '+' : '';
                const color = pct > 0 ? 'text-rose-700 bg-rose-50' : 'text-emerald-700 bg-emerald-50';
                return `<span class="inline-block text-[10px] font-en font-bold ${color} px-1.5 py-0.5 rounded">${sign}${pct.toFixed(1)}%</span>`;
            }
            return '';
        }

        // Render individual payer cell
        function renderPayerCell(row, payerKey, stats, baselineMode) {
            const info = row[payerKey] || {};
            const effectiveVal = stats.prices[payerKey];
            const isHighest = stats.validCount >= 2 && effectiveVal !== null && effectiveVal === stats.maxVal && effectiveVal > 0;

            // Show K-formula helper if active on endoscopy rows
            let kSubText = '';
            if (row.kType && state.endoscopyMode === 'k_calc' && effectiveVal !== null) {
                const units = row.kType === 'gastro' ? state.gastroK : state.colonoK;
                const kUnitPrice = payerKey === 'coop'
                    ? (row.setting === 'Inpatient' ? K_RATES.coop_inpatient : K_RATES.coop_outpatient)
                    : K_RATES.rasool;
                kSubText = `<div class="text-[10px] font-en text-indigo-700 font-semibold">${units}K × $${kUnitPrice} <span class="text-slate-400">(ثابت: $${info.fixedPrice})</span></div>`;
            } else if (row.kType && state.endoscopyMode === 'fixed' && effectiveVal !== null) {
                const units = row.kType === 'gastro' ? state.gastroK : state.colonoK;
                const kUnitPrice = payerKey === 'coop'
                    ? (row.setting === 'Inpatient' ? K_RATES.coop_inpatient : K_RATES.coop_outpatient)
                    : K_RATES.rasool;
                kSubText = `<div class="text-[10px] font-en text-slate-500">(${units}K = $${(units * kUnitPrice).toLocaleString()})</div>`;
            }

            if (effectiveVal === null) {
                return `
                    <td class="py-3 px-3 text-center align-middle border-x border-slate-100">
                        <span class="inline-block text-xs font-semibold px-2 py-0.5 rounded-md ${info.status === 'لا يغطى' ? 'bg-rose-50 text-rose-700 border border-rose-200' : 'bg-slate-100 text-slate-500'}">
                            ${info.status || '—'}
                        </span>
                        ${info.cov ? `<div class="text-[10px] text-slate-400 font-en mt-0.5">تغطية ${info.cov}</div>` : ''}
                    </td>
                `;
            }

            const diffBadge = getDiffBadgeHTML(effectiveVal, stats, baselineMode, stats.prices.rasool);

            return `
                <td class="py-3 px-3 text-center align-middle border-x border-slate-100 transition-colors ${isHighest ? 'highest-cell' : ''}">
                    <div class="flex flex-col items-center justify-center gap-0.5">
                        ${isHighest ? `<span class="text-[10px] font-extrabold uppercase tracking-wider bg-amber-500 text-slate-950 px-2 py-0.2 rounded-full font-en shadow-2xs">★ HIGHEST</span>` : ''}
                        <div class="text-base font-extrabold font-en ${isHighest ? 'text-amber-950' : 'text-slate-900'}">
                            ${formatUSD(effectiveVal)}
                        </div>
                        ${kSubText}
                        <div class="flex items-center justify-center gap-1 flex-wrap mt-0.5">
                            ${info.cov ? `<span class="text-[10px] font-en font-semibold text-slate-600 bg-slate-200/70 px-1.5 py-0.2 rounded">${info.cov}</span>` : ''}
                            ${diffBadge}
                        </div>
                        ${info.note ? `<div class="text-[10px] text-slate-500 mt-0.5 leading-tight">${info.note}</div>` : ''}
                    </div>
                </td>
            `;
        }

        // Main Table Render Function
        function renderTable() {
            const search = document.getElementById('search-input').value.trim().toLowerCase();
            const catFilter = document.getElementById('category-filter').value;
            const settingFilter = document.getElementById('setting-filter').value;
            const matchedOnly = document.getElementById('matched-only-toggle').checked;
            const sortBySpread = document.getElementById('highest-diff-sort').checked;
            const baselineMode = document.getElementById('diff-baseline').value;

            let filtered = servicesData.filter(row => {
                const isSelected = state.selectedIds.has(row.id);
                const matchesText = !search ||
                    row.ar.toLowerCase().includes(search) ||
                    row.en.toLowerCase().includes(search) ||
                    row.categoryAr.toLowerCase().includes(search);
                const matchesCat = catFilter === 'ALL' || row.category === catFilter;
                const matchesSetting = settingFilter === 'ALL' || row.setting === settingFilter;
                const stats = analyzeRow(row);
                const matchesCount = !matchedOnly || stats.validCount >= 2;
                return isSelected && matchesText && matchesCat && matchesSetting && matchesCount;
            });

            if (sortBySpread) {
                filtered = [...filtered].sort((a, b) => analyzeRow(b).spreadPct - analyzeRow(a).spreadPct);
            }

            renderKPIs(filtered);

            const tbody = document.getElementById('comparison-tbody');
            const emptyState = document.getElementById('empty-state');

            if (filtered.length === 0) {
                tbody.innerHTML = '';
                emptyState.classList.remove('hidden');
                return;
            }
            emptyState.classList.add('hidden');

            const payerLabels = {
                rasool: 'Rasool',
                reaya: 'الرعاية',
                daman: 'الضمان',
                coop: 'التعاونية'
            };

            tbody.innerHTML = filtered.map(row => {
                const stats = analyzeRow(row);
                const highestNames = stats.highestPayers.map(p => payerLabels[p]).join(' & ');

